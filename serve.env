# Environment for services started by `make serve` (scripts/serve-latest.sh).
# Mirrors docker-compose.yml. Give each new service its own port here.
# Variables already set in your shell win, e.g. POS_ADDR=:9090 make serve

# POS terminal: http://localhost:8080
POS_ADDR=:8080
MERCHANT_ID=000000000012345
TERMINAL_ID=TERM0001
MERCHANT_NAME="Simple Coffee Co"
MERCHANT_CITY="San Francisco"
MERCHANT_COUNTRY=US
MERCHANT_TZ=America/Los_Angeles
MCC=5814

# Acquirer identity and the PIN key it shares with the network (POS and network)
ACQUIRER_ID=100001

# Network switch and dashboard: http://localhost:8090
NETWORK_ADDR=:8090
NETWORK_URL=http://localhost:8090
NETWORK_DASHBOARD_URL=http://localhost:8090

# Issuers (one process, one port per bank)
ISSUER_FSB_ADDR=:8091
ISSUER_UCB_ADDR=:8092
ISSUER_FSB_URL=http://localhost:8091
ISSUER_UCB_URL=http://localhost:8092
