#!/usr/bin/env bash
# Block commits whose Go code doesn't build or pass tests.
#
# It checks the staged snapshot (what the commit will contain), not the working
# tree, so unrelated unstaged edits can't block or sneak past it.
# Enable once per clone with: make hooks
# Skip in an emergency with: git commit --no-verify
set -euo pipefail

# Only Go-relevant commits need the check.
if ! git diff --cached --name-only --diff-filter=ACMRD | grep -qE '\.go$|^go\.(mod|sum)$|^cmd/|^internal/'; then
  exit 0
fi

snap="$(mktemp -d "${TMPDIR:-/tmp}/precommit.XXXXXX")"
trap 'rm -rf "$snap"' EXIT
git checkout-index --all --prefix="$snap/"

echo "pre-commit: building and testing the staged snapshot..."
if ! (cd "$snap" && go build ./... && go vet ./... && go test ./... >"$snap/.test.log" 2>&1); then
  [[ -f "$snap/.test.log" ]] && grep -E '^(--- FAIL|FAIL|panic:|ok )|_test.go:[0-9]+' "$snap/.test.log" | head -30
  echo
  echo "pre-commit: ✗ commit blocked. Fix the errors above (or use --no-verify to skip)." >&2
  exit 1
fi
echo "pre-commit: ✓ build, vet and tests pass"
